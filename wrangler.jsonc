{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "automation-chief-engineer-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "zg.gaona.world",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "MODEL_PROVIDER": "minimax",
    "MINIMAX_BASE_URL": "https://api.minimax.cn/v1",
    "MINIMAX_MODEL": "MiniMax-M3",
    "GPT_SOL_BASE_URL": "https://api.openai.com/v1",
    "GPT_SOL_MODEL": "gpt-5.6-sol"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "automation-chief-engineer-cloud",
      "database_id": "f40e6240-98aa-40d7-bb0a-80130b5ca055",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "automation-chief-engineer-artifacts"
    }
  ],
  "containers": [
    {
      "class_name": "CadcoreSandbox",
      "image": "./cadcore/Dockerfile",
      "instance_type": "lite",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TASK_COORDINATOR", "class_name": "TaskCoordinator" },
      { "name": "CADCORE", "class_name": "CadcoreSandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TaskCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["CadcoreSandbox"] }
  ],
  "workflows": [
    {
      "name": "ace-task-workflow",
      "binding": "TASK_WORKFLOW",
      "class_name": "TaskWorkflow"
    }
  ]
}
